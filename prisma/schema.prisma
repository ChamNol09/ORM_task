generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  token     String?  @db.Text
  role_id   Int      @default(1)
  role      Roles    @relation(fields: [role_id], references: [id])
  createdAt DateTime @default(now())
}

model Roles {
  id        Int      @id @default(autoincrement())
  name      String
  users     User[]
  createdAt DateTime @default(now())
}